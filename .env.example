NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: transactional email for assignments, comments, status changes, reports.
# Sign-in codes still send via Supabase Auth SMTP without this.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Parallel Commerce <login@parallelcommerce.co.uk>

# Optional: Claude narrative for project reports, and CRM company lookup
# (summary + LinkedIn). Falls back to a plain digest for reports if unset.
# Get a key at https://console.anthropic.com — separate from Claude.ai subscription.
ANTHROPIC_API_KEY=
# Optional override (default: claude-sonnet-5)
ANTHROPIC_MODEL=

# Shopify store dashboard (per-project custom apps). Required to save tokens.
# Generate a long random string and keep it server-side only.
SHOPIFY_TOKEN_ENCRYPTION_KEY=
# Optional, comma-separated. Default: read_orders,read_themes
SHOPIFY_SCOPES=
