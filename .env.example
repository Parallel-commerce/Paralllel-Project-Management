NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: transactional email for assignments, comments, status changes, reports.
# Invite magic links still send via Supabase Auth without this.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Parallel <onboarding@resend.dev>

# Optional: Claude narrative for project reports (falls back to a plain digest).
# Get a key at https://console.anthropic.com — separate from Claude.ai subscription.
ANTHROPIC_API_KEY=
# Optional override (default: claude-sonnet-5)
ANTHROPIC_MODEL=
